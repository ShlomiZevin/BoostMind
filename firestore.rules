rules_version = '2';
// boostmind-b052c's Firestore. Anything not matched below is closed to browsers (Firestore denies by default): requests,
// siteUsers, downloads, guard, catalog*, greetings, greetingVoice, syncsCost, aiSpend, owner/*, meetings, chatNotes,
// sheetEdits, scriptCraft, mailUsers... are written and read only by our functions (Admin SDK, rules don't apply).
// Security pass 22.11 (after the scripted probe): anyone can get a signed-in token through the email-code sign-in, so
// "signed in" proves nothing - private data is readable only by its owner, and nothing a browser writes can grant power.
// Proven before deploy with the Rules API test endpoint: node scripts/security/rules-test.cjs
service cloud.firestore {
  match /databases/{database}/documents {

    // Shlomi's own Google account (verified).
    function isShlomi() {
      return request.auth != null
        && request.auth.token.email == 'shlomi@boostart.io'
        && request.auth.token.email_verified == true;
    }
    // Wholos' hardcoded admins (wholos src/config/admins.ts ADMIN_EMAILS). The legacy Wholos at wholos.com still runs on
    // this project until its cutover to wholos-app; its runtime `users_index.isAdmin` flag can no longer be self-granted.
    function isWholosAdmin() {
      return request.auth != null
        && request.auth.token.email in ['shlomi@boostart.io', 'sergiokatz78@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function changes(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([f]);
    }

    // ─── The Shlomiverse (techietech-api/verse.js) ───────────────
    // Fans only READ here; every write goes through the `verse` function.
    match /fans/{uid} { allow read: if request.auth != null && request.auth.uid == uid; }
    match /fans/{uid}/{sub=**} { allow read: if request.auth != null && request.auth.uid == uid; }
    // comments and posted stickers are public; a query must ask for hidden == false (and status == 'live')
    match /comments/{id} { allow read: if resource.data.hidden == false; }
    match /stickers/{id} {
      allow read: if (resource.data.status == 'live' && resource.data.hidden == false)
                  || (request.auth != null && request.auth.uid == resource.data.uid);
    }
    match /stories/{id} { allow read: if resource.data.hidden == false; }
    // the community wall: everyone reads the ideas Shlomi didn't hide
    match /ideas/{id} { allow read: if resource.data.hidden == false; }
    match /videoStats/{id} { allow read: if true; }
    // daily game records: the day's top 10 is public (nickname + first name); each player's own entry
    // (records/<id>/players/<uid>) stays server-only - this match does not reach subcollections
    match /records/{id} { allow read: if true; }
    // Piko (techietech-api/piko.js): his app listens to its jobs while they are made; writes are server-only
    match /pikoJobs/{id} { allow read: if isShlomi(); }

    // ─── Storyboard tool (public/storyboard) ─────────────────────
    // No sign-in in that app: reading and editing stay open, deleting a board is closed (data never disappears).
    match /storyboards/{docId} {
      allow read, create, update: if true;
      allow delete: if isShlomi();
    }

    // ─── Geek & Prompty shop (public/yotamverse) ─────────────────
    // Products + settings are public to read, written only from the admin page signed in as Shlomi. Orders hold names,
    // phones and addresses: anyone can place one (the shop page writes without auth), only the admin reads or changes them.
    match /gp-products/{docId} {
      allow read: if true;
      allow write: if isShlomi();
    }
    match /gp-shop/{docId} {
      allow read: if true;
      allow write: if isShlomi();
    }
    match /gp-orders/{docId} {
      allow read, update, delete: if isShlomi();
      allow create: if request.resource.data.keys().hasOnly(['orderNum', 'name', 'phone', 'city', 'street', 'notes', 'items',
                         'subtotal', 'shipping', 'total', 'hasPhysical', 'status', 'source', 'email', 'uid', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 120))
        && (!('street' in request.resource.data) || (request.resource.data.street is string && request.resource.data.street.size() <= 200))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128))
        && request.resource.data.items is list && request.resource.data.items.size() <= 40;
    }

    // ─── Dead collections (kept, never deleted - his rule) ───────
    // mundial*, party-rsvp: no page uses them any more; they held people's names, ages, chats. Closed to browsers.
    // (no match = denied)

    // ─── Legacy Wholos (wholos.com/wholos-app, frozen bundle in public/wholos-app) ───
    // Helper: is the calling user the coach of this trainee?
    function isCoachOf(traineeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(traineeId)/profile/main)
        && get(/databases/$(database)/documents/users/$(traineeId)/profile/main).data.coachUid == request.auth.uid;
    }
    // Each user reads/writes only their OWN tree; Shlomi (his app uid user_6724 differs from his auth uid) and the
    // user's coach too.
    match /users/{userId}/{document=**} {
      allow read, write:
        if request.auth != null
           && (request.auth.uid == userId
               || isShlomi()
               || isCoachOf(userId));
    }
    // Chat threads: the old workout-ai Cloud Run writes them through unauthenticated REST, so create/update stay open
    // until Wholos moves to wholos-app; reads and deletes are the user's (and Shlomi's) only.
    match /users/{userId}/chatThreads/{threadId} {
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isShlomi());
      allow create, update: if true;
    }
    match /users/{userId}/chatThreads/{threadId}/messages/{msgId} {
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isShlomi());
      allow create, update: if true;
    }
    match /users/{userId}/appliedChatActions/{key} {
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isShlomi());
      allow create, update: if true;
    }
    // Bug/feature reports (all land under users/user_6724/reports). Before: open to the world. Now: a signed-in user files
    // one in their own name; only the admins list, triage and delete them.
    match /users/{userId}/reports/{reportId} {
      allow read, update, delete: if isWholosAdmin();
      allow create: if isWholosAdmin() || (request.auth != null && request.resource.data.authorUid == request.auth.uid);
    }
    // Global exercise DB + default photos: everyone reads, only the admins write.
    match /exercises/{docId} {
      allow read: if true;
      allow write: if isWholosAdmin();
    }
    match /defaultExercisePhotos/{docId} {
      allow read: if true;
      allow write: if isWholosAdmin();
    }
    // Auth alias: firebaseAuthUid -> legacyUid. Only for your own raw uid.
    match /authAliases/{authUid} {
      allow read, write: if request.auth != null && (request.auth.uid == authUid || isShlomi());
    }
    // Launch analytics: anyone can CREATE a Wholos event (the landing page fires them unauthenticated) - with no `t` / `e`
    // fields so nobody can slip fake rows into the Shlomiverse's own analytics (written by functions, read by `t`).
    // Reading: admins only (before: the world).
    match /analytics_events/{eventId} {
      allow create: if request.resource.data.type is string && request.resource.data.type.size() <= 40
                    && request.resource.data.ts is int
                    && !request.resource.data.keys().hasAny(['t', 'e', 'exp', 's', 'x', 'm'])
                    && request.resource.data.size() <= 25;
      allow read: if isWholosAdmin();
      allow delete: if isShlomi();
      allow update: if false;
    }
    // Wholos user registry. Before: the world read every email, and any signed-in account could write any row (and make
    // itself admin through `isAdmin`). Now: your own row (the admins all rows); `isAdmin` only by an admin; `role` only
    // 'coacher' (the coach invite link). A coach's row is readable (the trainee's invite screen shows the coach).
    match /users_index/{uid} {
      allow get: if request.auth != null
                 && (request.auth.uid == uid
                     || resource.data.authUid == request.auth.uid
                     || resource.data.role == 'coacher'
                     || isWholosAdmin()
                     || isCoachOf(uid));
      allow list: if isWholosAdmin()
                  || (request.auth != null && (resource.data.authUid == request.auth.uid || resource.data.isAdmin == true));
      allow create: if isWholosAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && !('isAdmin' in request.resource.data)
                        && (!('role' in request.resource.data) || request.resource.data.role == 'coacher')
                        && (!('authUid' in request.resource.data) || request.resource.data.authUid == request.auth.uid));
      allow update: if isWholosAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && !changes('isAdmin')
                        && (!changes('role') || request.resource.data.role == 'coacher')
                        && (!changes('authUid') || request.resource.data.authUid == request.auth.uid));
      allow delete: if isWholosAdmin();
    }
    // LLM usage log: the old workout-ai writes it unauthenticated (create only); only the admins read it.
    match /ai_usage/{eventId} {
      allow create: if true;
      allow read: if isWholosAdmin();
      allow update, delete: if false;
    }
    // ─── Vault (moved to shlomi-tools; data kept) ────────────────
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
