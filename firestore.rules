rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /storyboards/{docId} {
      allow read, write: if true;
    }
    // Helper: is the calling user the coach of this trainee?
    // Reads the trainee's profile doc and checks coachUid. Used to grant coach
    // read/write access to specific parts of a trainee's tree.
    function isCoachOf(traineeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(traineeId)/profile/main)
        && get(/databases/$(database)/documents/users/$(traineeId)/profile/main).data.coachUid == request.auth.uid;
    }

    // Each user reads/writes only their OWN tree. Owner (shlomi@boostart.io)
    // sees everything for admin surfaces + the reports-admin page. Coaches
    // read+write their trainees' trees too (chats excluded — separate rule
    // below).
    //
    // Note: `request.auth.uid` is the raw Firebase Auth uid, while `userId` in
    // the path is the app-level uid — for Shlomi they differ (EMAIL_TO_UID
    // maps his Google account to legacy `user_6724`). The email exception
    // keeps him working; every other user's raw uid equals their doc path.
    match /users/{userId}/{document=**} {
      allow read, write:
        if request.auth != null
           && (request.auth.uid == userId
               || request.auth.token.email == 'shlomi@boostart.io'
               || isCoachOf(userId));
    }
    // ─── Chat threads — coach CANNOT read ────────────────────────
    // Trainees' chat history is private. A coach can guide, plan, and add
    // meals/exercises but cannot see what the trainee talks to the AI about.
    // Reads locked to owner + Shlomi. Writes stay open so the Cloud Run
    // backend can persist assistant replies without service-account creds.
    match /users/{userId}/chatThreads/{threadId} {
      allow read:
        if request.auth != null
           && (request.auth.uid == userId
               || request.auth.token.email == 'shlomi@boostart.io');
      allow write: if true;
    }
    match /users/{userId}/chatThreads/{threadId}/messages/{msgId} {
      allow read:
        if request.auth != null
           && (request.auth.uid == userId
               || request.auth.token.email == 'shlomi@boostart.io');
      allow write: if true;
    }
    // Server also writes to the applied-actions marker (which chat action was
    // "approved") — coach can't peek either.
    match /users/{userId}/appliedChatActions/{key} {
      allow read:
        if request.auth != null
           && (request.auth.uid == userId
               || request.auth.token.email == 'shlomi@boostart.io');
      allow write: if true;
    }
    // Bug/feature reports. The desktop admin page + Claude sessions both hit
    // this collection via unauthenticated REST — the URL is the secret,
    // same as ai_usage / analytics_events. Open read+write so a session can
    // read the open list and close entries without an auth token.
    match /users/{userId}/reports/{reportId} {
      allow read, write: if true;
    }
    match /gp-products/{docId} {
      allow read, write: if true;
    }
    match /gp-orders/{docId} {
      allow read, write: if true;
    }
    match /gp-shop/{docId} {
      allow read, write: if true;
    }
    match /mundial/{docId} {
      allow read, write: if true;
    }
    match /mundial-games/{docId} {
      allow read, write: if true;
    }
    match /mundial-players/{docId} {
      allow read, write: if true;
    }
    match /mundial-chat/{docId} {
      allow read, write: if true;
    }
    match /mundial-hottakes/{docId} {
      allow read, write: if true;
    }
    match /party-rsvp/{docId} {
      allow read, write: if true;
    }
    match /fleet_sessions/{docId} {
      allow read, write: if true;
    }
    match /fleet_notes/{docId} {
      allow read, write: if true;
    }
    match /defaultExercisePhotos/{docId} {
      allow read, write: if true;
    }
    // Global exercise DB — shared across all users. Read-open; write also open
    // for now (client-side gating restricts writes to the admin user). Once the
    // Firebase Auth migration lands we tighten this to `request.auth.token.email == "shlomi@boostart.io"`.
    match /exercises/{docId} {
      allow read, write: if true;
    }
    // Auth alias: firebaseAuthUid → legacyUid. Written from Settings when a user
    // claims an existing passcode-based account (used by shlomi@boostart.io when
    // signing in with a Google email that doesn't match the hardcoded map).
    //
    // A user can only claim an alias FOR THEIR OWN raw Firebase Auth uid —
    // otherwise anyone could set `authAliases/<their_uid>.legacyUid = user_6724`
    // and inherit Shlomi's account on next login. Read stays open so the
    // sync-resolver can look up any alias by uid.
    match /authAliases/{authUid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == authUid;
    }

    // ─── Launch analytics ────────────────────────────────────────
    // Append-only event log. Anyone can CREATE an event (the anonymous
    // landing page fires them). READ is open too so the desktop
    // /admin-desktop and /users-admin pages work regardless of who is
    // signed in — the URL is the secret. Update stays blocked; delete is
    // owner-only.
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if true;
      allow delete: if request.auth != null
                       && request.auth.token.email == 'shlomi@boostart.io';
      allow update: if false;
    }
    // Lightweight user registry: one doc per app uid, upserted on sign-in.
    // Any signed-in user writes their own row. READ is open so the desktop
    // admin views can render the user list from any session/device — the
    // page URL is private, keep it that way.
    match /users_index/{uid} {
      allow write: if request.auth != null;
      allow read: if true;
    }
    // ─── LLM usage log ───────────────────────────────────────────
    // The Cloud Run server writes one doc per Anthropic response with
    // per-message token counts + cost. Read is open (admin desktop needs
    // it and the URL is the secret); the server writes without auth.
    match /ai_usage/{eventId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
