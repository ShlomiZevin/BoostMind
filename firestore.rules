rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /storyboards/{docId} {
      allow read, write: if true;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    match /gp-products/{docId} {
      allow read, write: if true;
    }
    match /gp-orders/{docId} {
      allow read, write: if true;
    }
    match /gp-shop/{docId} {
      allow read, write: if true;
    }
    match /mundial/{docId} {
      allow read, write: if true;
    }
    match /mundial-games/{docId} {
      allow read, write: if true;
    }
    match /mundial-players/{docId} {
      allow read, write: if true;
    }
    match /mundial-chat/{docId} {
      allow read, write: if true;
    }
    match /mundial-hottakes/{docId} {
      allow read, write: if true;
    }
    match /party-rsvp/{docId} {
      allow read, write: if true;
    }
    match /fleet_sessions/{docId} {
      allow read, write: if true;
    }
    match /fleet_notes/{docId} {
      allow read, write: if true;
    }
    match /defaultExercisePhotos/{docId} {
      allow read, write: if true;
    }
    // Global exercise DB — shared across all users. Read-open; write also open
    // for now (client-side gating restricts writes to the admin user). Once the
    // Firebase Auth migration lands we tighten this to `request.auth.token.email == "shlomi@boostart.io"`.
    match /exercises/{docId} {
      allow read, write: if true;
    }
    // Auth alias: firebaseAuthUid → legacyUid. Written from Settings when a user
    // claims an existing passcode-based account (used by shlomi@boostart.io when
    // signing in with a Google email that doesn't match the hardcoded map).
    match /authAliases/{authUid} {
      allow read, write: if true;
    }

    // ─── Launch analytics ────────────────────────────────────────
    // Append-only event log. Anyone (including the anonymous landing page)
    // can CREATE an event; only the owner email can read the log through
    // the admin panel. Update stays blocked; delete is allowed to the
    // owner so a one-shot cleanup pass in AnalyticsAdmin can prune the
    // owner's own polluting events without any special tooling.
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, delete: if request.auth != null
                            && request.auth.token.email == 'shlomi@boostart.io';
      allow update: if false;
    }
    // Lightweight user registry: one doc per app uid, upserted on sign-in.
    // Any signed-in user may write their own row (client keys by resolved
    // appUid, which does not always equal the raw Firebase Auth uid —
    // Shlomi's alias maps to user_6724, for example). Read is admin only.
    match /users_index/{uid} {
      allow write: if request.auth != null;
      allow read: if request.auth != null
                    && request.auth.token.email == 'shlomi@boostart.io';
    }
    // ─── LLM usage log ───────────────────────────────────────────
    // The Cloud Run server writes one doc per Anthropic response with
    // per-message token counts + cost. Same shape as analytics_events:
    // anyone can create (the server writes without an auth token), only
    // the owner email can read from the admin dashboard.
    match /ai_usage/{eventId} {
      allow create: if true;
      allow read: if request.auth != null
                    && request.auth.token.email == 'shlomi@boostart.io';
      allow update, delete: if false;
    }
  }
}
