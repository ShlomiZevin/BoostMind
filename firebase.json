{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/zvin-collab{,/**}",
        "destination": "/micro-comedy/",
        "type": 301
      },
      {
        "source": "/geek-and-prompty/:rest*",
        "destination": "/yotamverse/:rest*",
        "type": 301
      },
      {
        "source": "/geek-and-prompty",
        "destination": "/yotamverse/",
        "type": 301
      },
      {
        "source": "/geek-and-prompty-v2{,/**}",
        "destination": "/yotamverse/",
        "type": 301
      },
      {
        "source": "/yotam{,/}",
        "destination": "/yotamverse/",
        "type": 301
      },
      {
        "source": "/workout-app{,/**}",
        "destination": "/wholos-app/",
        "type": 301
      },
      {
        "source": "/matzav-app{,/**}",
        "destination": "/wholos-app/",
        "type": 301
      },
      {
        "source": "/matzav{,/**}",
        "destination": "/wholos/",
        "type": 301
      },
      {
        "source": "/boostart{,/}",
        "destination": "https://boostart-pro.web.app/",
        "type": 301
      },
      {
        "source": "/boostart/:rest*",
        "destination": "https://boostart-pro.web.app/:rest*",
        "type": 301
      },
      {
        "destination": "https://boostart-pro.web.app/",
        "type": 301,
        "regex": "^/(ai-algorithms|ai-copilot-n8n|ai-dating-mgmt|ai-implementation|ai-native-dev|ai-os-engineer|ai-personalized-pod|b2b-medusa-store|bancs-ogen|claude-automation|claude-cowork-mentor|claude-guide|cloud-architect|cpai-fintech|crm-custom|edu-cto|erez-ai-mentor|erp-construction-ai|eyeloveyou|eyeloveyou-chat|family-tv|food-ecommerce|fullstack-ai-agents|home-improvement-ai|insurance-crm-ai|island-proposal|jewelry-store|legal-ai-automation|lovable-migration|magen-crm|marketplace-mvp|marketplace-users|ml-fraud-detection|mortgage-brand|pdf-calculator|privacy-platform|progress|realestate-3d|realestate-ai|senior-saas-backend|smart-agent|tarot-ai-chat|thegapper|torah-lessons|travel-ops|webrtc-tv-poc|wolt-proposal|aspect-insights)(/.*)?$"
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/wholos/index.html"
      },
      {
        "source": "/storyboard/**",
        "destination": "/storyboard/index.html"
      },
      {
        "source": "/wholos-app/**",
        "destination": "/wholos-app/index.html"
      },
      {
        "source": "/wholos/**",
        "destination": "/wholos/index.html"
      },
      {
        "source": "/matzav/**",
        "destination": "/matzav/index.html"
      }
    ],
    "headers": [
      {
        "source": "/hani-games/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
