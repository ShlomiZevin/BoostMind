{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/c/neve-dugi{,/**}", "destination": "/c/neve-tzafoni", "type": 301 },
      { "source": "/c/neve-dromi{,/**}", "destination": "/c/neve-tzafoni", "type": 301 },
      {
        "source": "/zvin-collab{,/**}",
        "destination": "/micro-comedy/",
        "type": 301
      },
      {
        "source": "/geek-and-prompty/:rest*",
        "destination": "/yotamverse/:rest*",
        "type": 301
      },
      {
        "source": "/geek-and-prompty",
        "destination": "/yotamverse/",
        "type": 301
      },
      {
        "source": "/geek-and-prompty-v2{,/**}",
        "destination": "/yotamverse/",
        "type": 301
      },
      {
        "source": "/yotam{,/}",
        "destination": "/yotamverse/",
        "type": 301
      },
      {
        "source": "/workout-app{,/**}",
        "destination": "/wholos-app/",
        "type": 301
      },
      {
        "source": "/matzav-app{,/**}",
        "destination": "/wholos-app/",
        "type": 301
      },
      {
        "source": "/matzav{,/**}",
        "destination": "/wholos/",
        "type": 301
      },
      {
        "source": "/boostart{,/}",
        "destination": "https://pro.boostart.io/",
        "type": 301
      },
      {
        "source": "/boostart/:rest*",
        "destination": "https://pro.boostart.io/:rest*",
        "type": 301
      },
      {
        "destination": "https://pro.boostart.io/",
        "type": 301,
        "regex": "^/(ai-algorithms|ai-copilot-n8n|ai-dating-mgmt|ai-implementation|ai-native-dev|ai-os-engineer|ai-personalized-pod|b2b-medusa-store|bancs-ogen|claude-automation|claude-cowork-mentor|claude-guide|cloud-architect|cpai-fintech|crm-custom|edu-cto|erez-ai-mentor|erp-construction-ai|eyeloveyou|eyeloveyou-chat|family-tv|food-ecommerce|fullstack-ai-agents|home-improvement-ai|insurance-crm-ai|island-proposal|jewelry-store|legal-ai-automation|lovable-migration|magen-crm|marketplace-mvp|marketplace-users|ml-fraud-detection|mortgage-brand|pdf-calculator|privacy-platform|progress|realestate-3d|realestate-ai|senior-saas-backend|smart-agent|tarot-ai-chat|thegapper|torah-lessons|travel-ops|webrtc-tv-poc|wolt-proposal|aspect-insights)(/.*)?$"
      }
    ],
    "rewrites": [
      {
        "source": "/piko/api/**",
        "function": {
          "functionId": "piko",
          "region": "europe-west1"
        }
      },
      {
        "source": "/mcp/**",
        "function": {
          "functionId": "verseMcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/mind/@(api|hook|mcp)",
        "function": {
          "functionId": "mind",
          "region": "europe-west1"
        }
      },
      {
        "source": "/c/**",
        "function": {
          "functionId": "versePage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/v/**",
        "function": {
          "functionId": "versePage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/play/**",
        "function": {
          "functionId": "versePage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/s/**",
        "function": {
          "functionId": "versePage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/simulation",
        "function": {
          "functionId": "versePage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/story/**",
        "function": {
          "functionId": "versePage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/games",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/characters",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/series",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/videos",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/sites",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/citizenship",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/community",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/records",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/business",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/notes",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/me",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/saved",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/my-characters",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/my-stickers",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/install",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/chat",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/tziftzif/p/**",
        "function": {
          "functionId": "verseTzPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/tziftzif/u/**",
        "function": {
          "functionId": "verseTzPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/tziftzif/a/**",
        "function": {
          "functionId": "verseTzPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/charadot/a/**",
        "function": {
          "functionId": "verseTzPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/tziftzif/**",
        "destination": "/tziftzif/index.html"
      },
      {
        "source": "/charadot/**",
        "destination": "/charadot/index.html"
      },
      {
        "source": "/storyboard/**",
        "destination": "/storyboard/index.html"
      },
      {
        "source": "/wholos-app/**",
        "destination": "/wholos-app/index.html"
      },
      {
        "source": "/wholos/**",
        "destination": "/wholos/index.html"
      },
      {
        "source": "/matzav/**",
        "destination": "/matzav/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|mp3|mp4|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/hani-games/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
